FROM golang:1.25-alpine AS builder
WORKDIR /app
RUN apk add --no-cache zip
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o bootstrap ./cmd/dlq-handler \
 && zip -j /dlq-handler.zip bootstrap

FROM scratch AS artifact
COPY --from=builder /dlq-handler.zip /dlq-handler.zip
