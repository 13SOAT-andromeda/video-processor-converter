# --- AWS / LocalStack ---
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566   # vazio em produção; setado só no local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Buckets / filas ---
S3_BUCKET=video-processor-bucket
STATUS_QUEUE_URL=http://localhost:4566/000000000000/video-processing-status-queue
# usados só pelo cmd/local (invoker dev):
WORKER_QUEUE_URL=http://localhost:4566/000000000000/video-processing-queue
DLQ_QUEUE_URL=http://localhost:4566/000000000000/video-processing-dlq

# --- Pipeline ---
EXPECTED_WIDTH=1920
EXPECTED_HEIGHT=1080
FRAME_RATE=1
TMP_DIR=/tmp

# --- Datadog (no-op local; ligado só em produção) ---
DD_TRACE_ENABLED=false
DD_ENV=local
DD_SERVICE=processing-worker
DD_VERSION=dev
