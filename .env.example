# --- AWS / LocalStack ---
AWS_REGION=us-east-1
# vazio em produção; setado só no local
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Buckets / filas ---
S3_BUCKET=video-processor-bucket
STATUS_QUEUE_URL=http://localhost:4566/000000000000/video-processing-status-queue
# usados só pelo cmd/local (invoker dev):
WORKER_QUEUE_URL=http://localhost:4566/000000000000/video-processing-queue
DLQ_QUEUE_URL=http://localhost:4566/000000000000/video-processing-dlq

# --- Pipeline ---
# Resolução máxima aceita (vídeos até esse limite são processados; acima, rejeitados)
MAX_WIDTH=1920
MAX_HEIGHT=1080
FRAME_RATE=1
TMP_DIR=/tmp

# --- Datadog ---
# opcional: preencha com uma API key real (site abaixo) para subir o serviço
# datadog-agent do docker-compose.yml e testar as métricas de ponta a ponta
# localmente. Vazio = app roda normal, só falha silenciosamente o envio (log warn).
DD_API_KEY=
DD_SITE=us5.datadoghq.com
DD_TRACE_ENABLED=false
DD_ENV=local
DD_SERVICE=processing-worker
DD_VERSION=dev

# --- Localstack (dev only) ---
LOCALSTACK_AUTH_TOKEN=
